!       implicit real*8 (a-h,o-z)
!       real*8  C(3,*), frc(3,*)
!       integer iat(*)
!       character*70 blabel 
!       blabel=' '
!       ibohm=1
!        
!        call pbdylcao(ibohm,nat,iat,C,Frc,Eelec,Emermin,blabel,V)
!        energy =  Emermin 
!         return
!         end
